# Mercado Pago — Checkout Pro
# Access token de TEST para desarrollo (Panel de Mercado Pago > Tus integraciones > Credenciales de prueba).
# Server-side únicamente — nunca exponer con prefijo NEXT_PUBLIC_.
MP_ACCESS_TOKEN=

# Resend — mail de confirmación al comprador + aviso de pedido nuevo al vendedor
RESEND_API_KEY=
# Opcional: sin dominio verificado en Resend, dejar vacío usa "onboarding@resend.dev"
# (solo entrega a la casilla dueña de la cuenta — sirve para probar, no para producción real).
RESEND_FROM_EMAIL=
# Casilla del vendedor a la que llega el aviso de cada pedido nuevo.
ADMIN_EMAIL=

# Twilio — aviso por WhatsApp al vendedor cuando entra un pedido nuevo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp habilitado en Twilio (sandbox o productivo), formato E.164 sin "whatsapp:".
TWILIO_WHATSAPP_FROM=
# Tu número (el vendedor), mismo formato E.164.
TWILIO_WHATSAPP_TO=
